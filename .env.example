# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard > Project Settings > Data API  (URL)
# Dashboard > Project Settings > API Keys  (service_role — server only, secret)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 ───────────────────────────────────────────────────────────
# Public base URL of the corbus-media bucket: either the r2.dev dev URL or a
# custom domain. No trailing slash. The bucket itself is reached through the
# MEDIA binding declared in wrangler.jsonc, not over the network.
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.example.com

# ── Admin panel ─────────────────────────────────────────────────────────────
# Password for /admin, checked on the server.
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
